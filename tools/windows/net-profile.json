{
  "name": "AIS Fibre - Huawei HG8045X6",
  "loginPage": "/",
  "homePage": "/index.asp",
  "loginPageMarker": "(?i)txt_Password|id=\"loginbutton\"|name=\"PassWord\"|<title>Waiting|top\\.location\\.replace\\(pageName\\)",
  "tokenUrl": "/asp/GetRandCount.asp",
  "loginUrl": "/login.cgi?&CheckCodeErrFile=login.asp",
  "loginBody": "UserName={user}&PassWord={pass}&Language=english&CheckCode={code}&x.X_HW_Token={token}",
  "loginCookie": "Cookie=body:Language:english:id=-1",
  "passModes": [
    "base64"
  ],
  "tokenInPage": "hwonttoken",
  "changeTokenUrls": [
    "/html/ssmp/common/getRandString.asp",
    "/html/ssmp/common/GetRandToken.asp"
  ],
  "devicesUrls": [
    "/html/bbsp/common/GetLanUserDevInfo.asp",
    "/html/bbsp/common/lanuserinfo.asp",
    "/html/amp/wlaninfo/getassociateddeviceinfo.asp"
  ],
  "filterPage": "/html/bbsp/wlanmacfilter/wlanmacfilter.asp",
  "filterPath": "InternetGatewayDevice.X_HW_Security.WLANMacFilter",
  "enabledField": [
    "enableFilter",
    "WlanMacFilterRight",
    "enableWlanFilter",
    "EnableWlanMacFilter"
  ],
  "policyField": [
    "Mode",
    "WlanMacFilterPolicy",
    "FilterMode"
  ],
  "policyWhitelist": "1",
  "maxEntries": 32,
  "addUrl": "/html/bbsp/wlanmacfilter/add.cgi?x={filterPath}&RequestFile={filterPageRel}",
  "addBody": "x.SourceMACAddress={mac}&x.SSIDName={ssid}&x.DeviceName={name}&x.Enable=1&x.X_HW_Token={token}",
  "delUrl": "/html/bbsp/wlanmacfilter/del.cgi?x={filterPath}&RequestFile={filterPageRel}",
  "delBody": "{entry}=&x.X_HW_Token={token}",
  "modeUrl": "/html/bbsp/wlanmacfilter/set.cgi?x=InternetGatewayDevice.X_HW_Security&RequestFile={filterPageRel}",
  "modeBody": "x.WlanMacFilterPolicy={policy}&x.WlanMacFilterRight={enabled}&x.X_HW_Token={token}",
  "captchaUrl": "/getCheckCode.cgi?&rand={rand}",
  "keepAliveSeconds": 60,
  "topoUrl": "/html/amp/wificoverinfo/getTopoInfo.asp",
  "ssids": [
    "SSID-1",
    "SSID-5",
    "SSID-6"
  ],
  "lanFilterUnused": {
    "filterPage": "/html/bbsp/macfilter/macfilter.asp",
    "filterPath": "InternetGatewayDevice.X_HW_Security.MacFilter",
    "enabledField": "enableFilter",
    "policyField": "Mode",
    "addUrl": "/html/bbsp/macfilter/add.cgi?x={filterPath}&RequestFile={filterPageRel}",
    "addBody": "x.SourceMACAddress={mac}&x.DeviceAlias={name}&x.X_HW_Token={token}",
    "delUrl": "/html/bbsp/macfilter/del.cgi?x={filterPath}&RequestFile={filterPageRel}",
    "delBody": "{entry}=&x.X_HW_Token={token}",
    "modeUrl": "/html/bbsp/macfilter/set.cgi?x=InternetGatewayDevice.X_HW_Security&RequestFile={filterPageRel}",
    "modeBody": "x.MacFilterPolicy={policy}&x.MacFilterRight={enabled}&x.X_HW_Token={token}"
  },
  "note": "Wi-Fi MAC filter (the LAN page only covers wired ports). One Wi-Fi (SSID) per device, 8 devices per SSID. ssids = which SSID ids the program uses; ssidNames = their Wi-Fi names (must match the router). SSID-1..4 = 2.4G, SSID-5..8 = 5G.",
  "perSsidMax": 8,
  "onePerDevice": true,
  "ssidNames": {
    "SSID-1": "Klaypan_2.4G",
    "SSID-5": "Klaypan_5G",
    "SSID-6": "Klaypan_admin"
  }
}
